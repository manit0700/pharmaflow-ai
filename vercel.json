{
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm --prefix server ci && npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/((?!api/.*).*)",
      "destination": "/index.html"
    }
  ]
}
