generator client {
  provider   = "prisma-client-js"
  engineType = "none"
}

datasource db {
  provider = "postgresql"
}

model CallJob {
  id                  String      @id @default(cuid())
  uploadBatchId       String?
  uploadBatch         UploadBatch? @relation(fields: [uploadBatchId], references: [id])
  patientName         String
  phoneNumber         String
  dob                 String
  medicationName      String
  rxNumber            String?
  callReason          String
  notes               String?
  prescriptionCost    Float?
  prescriptionsJson   String?
  validationStatus    String      @default("pending")
  validationError     String?
  callStatus          String      @default("queued")
  twilioCallSid       String?
  vapiCallId          String?
  callAttemptedAt     DateTime?
  callCompletedAt     DateTime?
  callDuration        Int?
  patientResponse     String?
  aiSummary           String?
  errorMessage        String?
  transcriptJson      String?
  messagesJson        String?
  aiConfidence        Float?
  resolutionStatus    String?
  resolvedAt          DateTime?
  resolvedBy          String?
  staffNotes          String?
  conversationState   String?
  verificationPassed  Boolean     @default(false)
  paymentChoice       String?
  paymentStatus       String      @default("not_started")
  fulfillmentChoice   String?
  deliveryAddress     String?
  staffCompleted      Boolean     @default(false)
  staffCompletedAt    DateTime?
  staffCompletedBy    String?
  safetyFlagsJson     String?
  duplicateOfId       String?
  doNotCall           Boolean     @default(false)
  staffFollowUpNeeded Boolean     @default(false)
  followUpReason      String?
  smsStatus           String      @default("none")
  recordingUrl        String?
  recordingSid        String?
  recordingDuration   Int?
  parentCallJobId     String?
  retryOfCallJobId    String?
  retryAttempt        Int         @default(0)
  maxRetryAttempts    Int         @default(3)
  scheduledFor        DateTime?
  retryReason         String?
  retryStatus         String      @default("none")
  createdFromOutcome  String?
  relatedTaskId       String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  staffTasks StaffTask[]
  callEvents CallEvent[]
  campaignPatients CampaignPatient[]

  @@index([callStatus])
  @@index([twilioCallSid])
  @@index([vapiCallId])
  @@index([createdAt])
  @@index([retryOfCallJobId])
  @@index([parentCallJobId])
  @@index([scheduledFor])
  @@index([retryStatus])
}

model Campaign {
  id        String   @id @default(uuid())
  name      String
  status    String   @default("draft")
  patients  CampaignPatient[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CampaignPatient {
  id         String   @id @default(uuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  callJobId  String
  callJob    CallJob  @relation(fields: [callJobId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([campaignId, callJobId])
  @@index([campaignId])
  @@index([callJobId])
}

model UploadBatch {
  id             String   @id @default(cuid())
  filename       String
  imported       Int      @default(0)
  valid          Int      @default(0)
  invalid        Int      @default(0)
  duplicateCount Int      @default(0)
  createdAt      DateTime @default(now())

  callJobs CallJob[]
}

model DoNotCallEntry {
  id          String   @id @default(cuid())
  phoneNumber String   @unique
  patientName String?
  reason      String?
  createdBy   String?
  createdAt   DateTime @default(now())
}

model StaffTask {
  id             String      @id @default(cuid())
  callJobId      String?
  callJob        CallJob?    @relation(fields: [callJobId], references: [id])
  patientName    String
  phoneNumber    String
  medicationName String?
  taskType       String
  priority       String      @default("normal")
  status         String      @default("open")
  notes          String?
  aiSummary      String?
  assignedTeam   String      @default("Unassigned")
  dueDate        String?
  dueTime        String      @default("15:00")
  sourceWorkflow String?
  issueSummary   String?
  activityJson   String?
  completedAt    DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  taskActivities TaskActivity[]

  @@index([status])
  @@index([priority])
  @@index([dueDate])
  @@index([callJobId])
}

model TaskActivity {
  id           String    @id @default(cuid())
  taskId       String
  task         StaffTask @relation(fields: [taskId], references: [id])
  activityType String
  message      String
  actor        String    @default("system")
  metadataJson String?
  createdAt    DateTime  @default(now())

  @@index([taskId])
}

model AuditEvent {
  id           String   @id @default(cuid())
  entityType   String
  entityId     String?
  action       String
  actor        String   @default("system")
  message      String
  metadataJson String?
  createdAt    DateTime @default(now())

  @@index([entityType, entityId])
}

model InboundCall {
  id             String   @id @default(cuid())
  callerPhone    String
  intent         String?
  patientName    String?
  dob            String?
  medicationName String?
  transcript     String?
  summary        String?
  status         String   @default("active")
  handoffReason  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model CallEvent {
  id            String   @id @default(cuid())
  callJobId     String?
  callJob       CallJob? @relation(fields: [callJobId], references: [id])
  twilioCallSid String?
  eventType     String
  eventPayload  String?
  createdAt     DateTime @default(now())
}
