generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model CallJob {
  id                  String   @id @default(cuid())
  patientName         String
  phoneNumber         String
  dob                 String
  medicationName      String
  callReason          String
  notes               String?
  validationStatus    String   @default("pending")
  validationError     String?
  callStatus          String   @default("queued")
  twilioCallSid       String?
  callAttemptedAt     DateTime?
  callCompletedAt     DateTime?
  callDuration        Int?
  patientResponse     String?
  aiSummary           String?
  errorMessage        String?
  transcriptJson      String?
  messagesJson        String?
  aiConfidence        Float?
  resolutionStatus    String?
  staffFollowUpNeeded Boolean  @default(false)
  followUpReason      String?
  smsStatus           String   @default("none")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  staffTasks StaffTask[]
  callEvents CallEvent[]
}

model StaffTask {
  id             String   @id @default(cuid())
  callJobId      String?
  callJob        CallJob? @relation(fields: [callJobId], references: [id])
  patientName    String
  phoneNumber    String
  medicationName String?
  taskType       String
  priority       String   @default("normal")
  status         String   @default("open")
  notes          String?
  aiSummary      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model InboundCall {
  id             String   @id @default(cuid())
  callerPhone    String
  intent         String?
  patientName    String?
  dob            String?
  medicationName String?
  transcript     String?
  summary        String?
  status         String   @default("active")
  handoffReason  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model CallEvent {
  id            String   @id @default(cuid())
  callJobId     String?
  callJob       CallJob? @relation(fields: [callJobId], references: [id])
  twilioCallSid String?
  eventType     String
  eventPayload  String?
  createdAt     DateTime @default(now())
}
