# Server

PORT=4002

NODE_ENV=development



# Local dev can use SQLite. Vercel production should use Postgres:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
DATABASE_URL="file:./dev.db"



# Twilio — office account

# Account SID from Console → Account Info (starts with AC)

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx



# API key (recommended): Console → API keys & tokens → Create API key

TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

TWILIO_API_KEY_SECRET=your_api_key_secret_here



# OR use main Auth Token instead of API key (leave API key vars empty)

TWILIO_AUTH_TOKEN=



TWILIO_PHONE_NUMBER=+16825551234

PHARMACY_STAFF_PHONE_NUMBER=+16825551234



AUTO_CALL_TEST_MODE=true



NGROK_AUTHTOKEN=



PUBLIC_BASE_URL=https://pharmaflow-ai.vercel.app



ENABLE_SMS_FOLLOWUP=false

PHARMACY_NAME=Premium Family Pharmacy

TWILIO_VOICE=Polly.Joanna

TWILIO_LANGUAGE=en-US

# Outbound call mode: dtmf (keypad scripts) or ai (OpenAI speech)
CALL_MODE=dtmf

# Required when CALL_MODE=ai
OPENAI_API_KEY=
CALL_AI_MODEL=gpt-4o-mini

# Optional safety controls
ENFORCE_BUSINESS_HOURS=false
BUSINESS_HOURS_START=8
BUSINESS_HOURS_END=20

